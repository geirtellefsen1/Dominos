# --- Postgres ---
POSTGRES_DB=dominion
POSTGRES_USER=dominion
POSTGRES_PASSWORD=change-me-in-prod

# --- Gateway ---
DOMINION_GATEWAY_ADDR=:3000

# 32+ byte random string; deploy.sh will generate one if left empty.
DOMINION_SESSION_SECRET=

# Bearer token SCIM clients must present; deploy.sh will generate if empty.
DOMINION_SCIM_TOKEN=

# Bearer token required by POST /admin/acl/grant and /revoke (phase 3).
# deploy.sh will generate one if left empty.
DOMINION_ADMIN_TOKEN=

# 32-byte base64 seed for the Ed25519 audit-log signing key (phase 4).
# deploy.sh will generate one if left empty. Keep this stable across
# restarts — exported bundles only verify against the key that signed them.
DOMINION_AUDIT_PRIVATE_KEY=

# --- OIDC (leave blank to disable /auth/login at boot) ---
# For local dev with the bundled mock-oauth2-server:
#   DOMINION_OIDC_ISSUER=http://mock-oidc:8090/default
# For a real Entra tenant:
#   DOMINION_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
DOMINION_OIDC_ISSUER=
DOMINION_OIDC_CLIENT_ID=
DOMINION_OIDC_CLIENT_SECRET=
DOMINION_OIDC_REDIRECT_URL=http://localhost:3000/auth/callback

# --- OpenFGA (phase 3) ---
DOMINION_FGA_API_URL=http://openfga:8080
DOMINION_FGA_STORE_NAME=dominion

# --- Dev shims (NEVER set true in production) ---
# When true, the gateway trusts an X-Dominion-Dev-Principal header of the
# form `user:<uuid>` for any request without a session cookie. Needed for
# the multi-user Phase 3 smoke tests until real OIDC flows are scripted.
DOMINION_DEV_PRINCIPAL_HEADER=true

# Public base URL used by smoke-test.sh. For a remote host set this to e.g.
# https://dominion.example.com
DOMINION_PUBLIC_URL=http://localhost:3000

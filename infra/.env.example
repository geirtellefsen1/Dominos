# --- Postgres ---
POSTGRES_DB=dominion
POSTGRES_USER=dominion
POSTGRES_PASSWORD=change-me-in-prod

# --- Gateway ---
DOMINION_GATEWAY_ADDR=:3000

# 32+ byte random string; deploy.sh will generate one if left empty.
DOMINION_SESSION_SECRET=

# Bearer token SCIM clients must present; deploy.sh will generate if empty.
DOMINION_SCIM_TOKEN=

# Bearer token required by POST /admin/acl/grant and /revoke (phase 3).
# deploy.sh will generate one if left empty.
DOMINION_ADMIN_TOKEN=

# 32-byte base64 seed for the Ed25519 audit-log signing key (phase 4).
# deploy.sh will generate one if left empty. Keep this stable across
# restarts — exported bundles only verify against the key that signed them.
DOMINION_AUDIT_PRIVATE_KEY=

# --- TLS + Dominion internal CA (phase 5) ---
# When true, the gateway also listens on :3443 with mTLS. Agents present
# a client cert signed by the internal CA; human session cookies still
# work on the TLS port too.
DOMINION_TLS_ENABLED=true
# Comma-separated extra hostnames for the auto-issued server cert.
DOMINION_TLS_HOSTNAMES=
# Comma-separated extra IPs for the auto-issued server cert (e.g. the
# droplet public IP so agents running off-host can verify the gateway).
DOMINION_TLS_IPS=
# Optional persistent CA. If both are blank the gateway generates an
# ephemeral CA on boot (agents issued before a restart stop authenticating).
DOMINION_CA_CERT_PEM=
DOMINION_CA_KEY_PEM=

# --- Secrets encryption (phase 6) ---
# 32-byte base64 AES-256 key used to encrypt OAuth refresh tokens at rest.
# deploy.sh will generate one if left empty. Keep stable — rotating this
# key orphans every stored refresh token.
DOMINION_ENCRYPTION_KEY=

# --- Microsoft Graph connector (phase 6) ---
# Leave blank to disable the mailbox-polling loop. To enable, register an
# app in Entra with redirect URI = DOMINION_GRAPH_REDIRECT_URL and delegated
# permissions offline_access + Mail.Read + User.Read.
DOMINION_GRAPH_CLIENT_ID=
DOMINION_GRAPH_CLIENT_SECRET=
DOMINION_GRAPH_TENANT_ID=common
DOMINION_GRAPH_REDIRECT_URL=http://localhost:3000/connectors/graph/callback

# Dev-only: expose POST /admin/connectors/graph/simulate so the smoke
# test can exercise the ingest pipeline without a live M365 tenant.
# MUST be false in production.
DOMINION_DEV_GRAPH_SIMULATE=true

# --- Triage / hero flow (phase 7) ---
# Anthropic API key used by the triage engine. Leave blank to run the
# deterministic stub (every email gets the same canned draft body;
# useful for the smoke test, useless for real demos).
DOMINION_ANTHROPIC_API_KEY=
DOMINION_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Scheduler cadence + per-pass email lookback window.
DOMINION_TRIAGE_INTERVAL=5m
DOMINION_TRIAGE_LOOKBACK=1h

# When true, /me/queue/{id}/approve records a fake sentMessageId
# instead of calling Graph /me/sendMail. Auto-on when
# DOMINION_DEV_GRAPH_SIMULATE=true and no Graph client is configured.
DOMINION_DEV_SIMULATE_SEND=

# --- Admin UI (phase 9) ---
# Comma-separated list of browser origins the gateway should emit CORS
# headers for. Leave blank to disable browser access.
# Local dev:   http://localhost:3100
# DO droplet:  http://139.59.173.17:3100
DOMINION_CORS_ORIGIN=http://localhost:3100

# --- OIDC (leave blank to disable /auth/login at boot) ---
# For local dev with the bundled mock-oauth2-server:
#   DOMINION_OIDC_ISSUER=http://mock-oidc:8090/default
# For a real Entra tenant:
#   DOMINION_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
DOMINION_OIDC_ISSUER=
DOMINION_OIDC_CLIENT_ID=
DOMINION_OIDC_CLIENT_SECRET=
DOMINION_OIDC_REDIRECT_URL=http://localhost:3000/auth/callback

# --- OpenFGA (phase 3) ---
DOMINION_FGA_API_URL=http://openfga:8080
DOMINION_FGA_STORE_NAME=dominion

# --- Dev shims (NEVER set true in production) ---
# When true, the gateway trusts an X-Dominion-Dev-Principal header of the
# form `user:<uuid>` for any request without a session cookie. Needed for
# the multi-user Phase 3 smoke tests until real OIDC flows are scripted.
DOMINION_DEV_PRINCIPAL_HEADER=true

# Public base URL used by smoke-test.sh. For a remote host set this to e.g.
# https://dominion.example.com
DOMINION_PUBLIC_URL=http://localhost:3000
